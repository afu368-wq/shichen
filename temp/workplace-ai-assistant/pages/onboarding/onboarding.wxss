/* pages/onboarding/onboarding.wxss */
.page {
  min-height: 100vh;
  padding: 60rpx 40rpx 120rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 60rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666666;
  line-height: 44rpx;
}

/* 表单卡片 */
.form-card {
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}

.form-item {
  margin-bottom: 50rpx;
}

.label {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 20rpx;
}

.picker {
  height: 88rpx;
  line-height: 88rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #999999;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker.selected {
  color: #333333;
  border-color: #6D8B74;
}

.picker .icon {
  font-size: 36rpx;
  color: #C0C0C0;
}

/* 时辰选择 */
.shichen-container {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.shichen-item {
  width: calc(33.33% - 12rpx);
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border: 2rpx solid #E8E4DC;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666666;
  background: #FAF8F4;
  transition: all 0.2s;
}

.shichen-item.selected {
  border-color: #6D8B74;
  background: #E8F0EA;
  color: #6D8B74;
  font-weight: 500;
}

.selected-display {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 提示 */
.tip {
  display: flex;
  align-items: flex-start;
  background: #F5F1E8;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 38rpx;
  margin-bottom: 44rpx;
}

.tip-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
  flex-shrink: 0;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #6D8B74;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  border: none;
}

.submit-btn.disabled {
  background: #C8D6CB;
}